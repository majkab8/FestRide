# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Secret used to sign JWT access tokens. Use a long random string in production.
SECRET_KEY=dev-secret-change-me

# How long an access token stays valid (minutes). Default: 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite database file (relative to the backend/ directory).
DATABASE_URL=sqlite:///./festride.db

# Origin of the frontend dev server, used for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini API key (free tier: https://aistudio.google.com). Leave empty to
# run without AI — search falls back to form filters, matching hides explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ticketmaster Discovery API key (https://developer.ticketmaster.com). Used only by
# the one-off import script. Leave empty to fall back to the small built-in seed.
TICKETMASTER_API_KEY=
